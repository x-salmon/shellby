    "src/renderer/panel/feed-changes.js",
    "src/renderer/panel/feed-logic.js",
    "src/renderer/panel/feed-native.js",
    "src/renderer/panel/feed-notes.js",
    "src/renderer/panel/feed.js",
    "src/renderer/panel/files-dock.js",
    "src/renderer/panel/history.js",
    "src/renderer/panel/lean.js",
    "src/renderer/panel/lessons.js",
    "src/renderer/panel/levels-ui.js",
    "src/renderer/panel/settings-pocket.js",
    "src/renderer/panel/shop.js",
    "src/renderer/panel/startfrom.js",

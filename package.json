{
  "name": "shellby",
  "productName": "Shellby",
  "version": "0.95.0",
  "description": "A Windows desktop app for Claude Code: parallel tasks on their own branches, undo for any turn and routines, on your own Claude Pro or Max plan. With a pixel hermit crab who does the work.",
  "main": "src/main/main.js",
  "author": "x-salmon",
  "license": "GPL-3.0-only",
  "homepage": "https://getshellby.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/x-salmon/shellby.git"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "windows",
    "ai-agent"
  ],
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "setup": "node scripts/setup.js",
    "dev:crab": "node scripts/dev-crab.js",
    "test": "node scripts/test.js",
    "lint": "eslint .",
    "panel:html": "node scripts/panel-html.js",
    "commands:check": "node scripts/commands-check.js",
    "typecheck": "tsc -p jsconfig.json",
    "e2e:ci": "node scripts/e2e-ci.js",
    "perf": "node scripts/perf-budget.js",
    "packs": "node scripts/validate-packs.js",
    "packs:format": "node scripts/format-packs.js",
    "packs:sheet": "python scripts/preview-packs.py",
    "icons": "python scripts/make-icons.py",
    "screenshots": "electron . --capture-screenshots",
    "reel": "electron . --capture-screenshots --reel && python scripts/make-reel.py",
    "tricks": "node scripts/record-tricks.js",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "release:cut": "node scripts/release-cut.js",
    "contest:tally": "node scripts/contest-tally.js",
    "contest:ship": "node scripts/contest-ship.js",
    "release:ready": "node scripts/release-guard.js ready --wait"
  },
  "dependencies": {
    "@sentry/electron": "^8.3.0",
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.3",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.xsalmon.shellby",
    "productName": "Shellby",
    "copyright": "Copyright (c) 2026 x-salmon",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md",
      "!src/renderer/panel/html/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "protocols": [
      {
        "name": "Shellby",
        "schemes": [
          "shellby"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "include": "packaging/nsis/installer.nsh",
      "artifactName": "Shellby-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Shellby-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "x-salmon",
        "repo": "shellby",
        "releaseType": "draft"
      }
    ]
  }
}
